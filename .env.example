# Copie para .env e preencha. O .env real nunca vai para o repositorio.

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Banco
POSTGRES_USER=altcast
# A mesma senha precisa aparecer no DATABASE_URL abaixo.
POSTGRES_PASSWORD=troque-por-32-bytes-aleatorios
POSTGRES_DB=altcast
DATABASE_URL=postgres://altcast:troque-por-32-bytes-aleatorios@postgres:5432/altcast

# Sessao
SESSION_COOKIE_NAME=altcast_session
SESSION_TTL_DAYS=30

# Quanto tempo alguem continua na chamada depois de o WebSocket dela cair.
# Existe porque a sala do LiveKit sobrevive a uma piscada de rede: sem a
# espera, a pessoa reconecta audivel e invisivel. Zero desliga.
VOICE_RECONNECT_GRACE_MS=15000

# ---------------------------------------------------------------------------
# Borda
# ---------------------------------------------------------------------------
# Esta implantacao tem DOIS proxies em serie:
#
#   navegador --https--> Nginx Proxy Manager --http--> Caddy --> api / livekit
#                        (termina o TLS, fora           (WEB_HTTP_PORT
#                         desta maquina)                 no host)
#
# Por isso PUBLIC_DOMAIN e `:80` e nao o dominio: o Caddy atende em texto claro
# e nao tenta emitir certificado para um nome cujo certificado ja existe uma
# camada acima. Quem enxerga o dominio e o navegador, e e o dominio que vale em
# PUBLIC_URL e ALLOWED_ORIGINS — sao eles que decidem cookie e checagem CSRF.
PUBLIC_DOMAIN=:80
# Porta HTTP publicada no host. Precisa estar livre e ser a mesma para onde o
# Nginx Proxy Manager encaminha.
WEB_HTTP_PORT=8081
# Ha proxy na frente: sem isto o limite de taxa por IP conta todo mundo junto.
TRUST_PROXY=true

ALLOWED_ORIGINS=https://altcast.exemplo.com.br
PUBLIC_URL=https://altcast.exemplo.com.br

# Para rodar na propria maquina, sem proxy nenhum: PUBLIC_DOMAIN=http://localhost,
# WEB_HTTP_PORT=80, TRUST_PROXY=false e as duas URLs em http://localhost.

# Bootstrap do primeiro usuario (uma unica vez). Minimo de 10 caracteres.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Fatia 2 — LiveKit
# ---------------------------------------------------------------------------
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# A URL aponta para o proprio dominio porque o Caddy encaminha /rtc ao SFU —
# a sinalizacao reaproveita o certificado que o proxy de fora ja tem.
# Para LiveKit Cloud, troque as tres por chave, segredo e wss:// do projeto.
LIVEKIT_API_KEY=altcast
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://altcast.exemplo.com.br
# ATENCAO: a midia NAO passa pelo proxy. O navegador fala UDP direto com o IP
# publico desta maquina em 51000-51100 (e TCP 17881 como saida de emergencia).
# Essas portas precisam estar abertas no firewall do host E na lista de
# seguranca da nuvem, senao a chamada conecta e fica muda.
#
# Só para testar na propria maquina, sem dominio. Deixe comentado em producao.
# LIVEKIT_CONFIG=./ops/livekit.local.yaml

# Fatia 3a — Anexos
# O MinIO nao publica porta nenhuma: quem fala com ele e a API, pela rede
# interna do compose. Estas credenciais nunca chegam ao navegador.
MINIO_ROOT_USER=altcast
MINIO_ROOT_PASSWORD=troque-esta-senha-por-uma-longa
STORAGE_ENDPOINT=minio
STORAGE_PORT=9000
STORAGE_BUCKET=altcast
STORAGE_USE_SSL=false

# ---------------------------------------------------------------------------
# Correio (Resend)
# ---------------------------------------------------------------------------
# Sem a chave a API sobe inteira e o correio escreve os e-mails no log em vez
# de envia-los. Em desenvolvimento isso percorre o fluxo de recuperacao de
# ponta a ponta sem credencial; em producao, deixa quem perdeu a senha sem
# caminho de volta.
RESEND_API_KEY=
# PRECISA ser de um dominio verificado no painel do Resend, senao o envio e
# recusado com 4xx e nenhuma repeticao conserta. As aspas importam: o `<` sem
# elas quebra quem le este arquivo pelo shell.
EMAIL_FROM="Altcast <nao-responda@seu-dominio.com.br>"
# Opcional: para onde vai a resposta de quem responder o e-mail.
# EMAIL_REPLY_TO=

# ATENCAO: os links de recuperacao e de confirmacao sao montados com PUBLIC_URL.
# Se ela estiver errada, o e-mail chega com um endereco que nao leva a lugar
# nenhum — e o unico jeito de descobrir isso e alguem tentar usar o link.
# Confira com: npm run email:teste -- voce@exemplo.com

# ---------------------------------------------------------------------------
# Entrega de e-mail: o DNS e o que decide
# ---------------------------------------------------------------------------
# A chave do Resend so autoriza o envio. Se a mensagem CHEGA, quem decide sao
# tres registros no DNS do dominio de EMAIL_FROM. Sem eles, o Gmail e o Outlook
# aceitam a mensagem e a jogam no spam — que e indistinguivel de "nao chegou"
# para quem esta esperando o link.
#
# No painel do Resend, em Domains, adicione o dominio e copie os registros que
# ele mostrar. Sao tres:
#
#   SPF    TXT em @        "v=spf1 include:amazonses.com ~all"
#   DKIM   CNAME/TXT       (o Resend gera o nome e o valor; copie exatamente)
#   DMARC  TXT em _dmarc   "v=DMARC1; p=none; rua=mailto:voce@seu-dominio"
#
# Espere o painel marcar "Verified" antes de confiar no envio. Enquanto nao
# estiver, o proprio Resend recusa — e o log da API mostra a recusa.

# ---------------------------------------------------------------------------
# Entrada pelo Google (opcional)
# ---------------------------------------------------------------------------
# Sem as duas variaveis a API sobe inteira e o botao simplesmente nao aparece
# na tela de entrada. Mesma politica do armazenamento e do correio.
#
# No Google Cloud Console, em APIs e servicos > Credenciais, crie um "ID do
# cliente OAuth" do tipo Aplicativo da Web e cadastre como Authorized redirect
# URI, exatamente:
#
#   https://seu-dominio.com.br/api/auth/google/callback
#   http://localhost/api/auth/google/callback      (para desenvolvimento)
#
# O endereco precisa bater caractere por caractere com PUBLIC_URL; divergencia
# de barra final ou de http/https faz o Google recusar a troca do codigo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Assina o cookie de dez minutos que carrega o `state` e o verificador PKCE
# entre a ida ao Google e a volta. Vazio cai no DATABASE_URL, o que funciona;
# preencher e melhor, porque separa os dois segredos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=

# TypeSafe (System One / Jev). Chave de servidor: nunca expor no cliente web.
# Vazia, todo recurso de IA aparece como "indisponivel" e o app segue inteiro
# pelo caminho sem IA. Cada grupo ainda precisa ligar cada recurso (aba IA).
TYPESAFE_API_KEY=
# Teto de julgamentos por grupo por dia; acima dele, o caminho sem IA.
IA_ORCAMENTO_DIARIO=2000
