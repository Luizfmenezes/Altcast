{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "outDir": "dist"
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"]
}
